{
  "name": "dsh-plugin-nextstep",
  "version": "0.1.0",
  "description": "Next-step prediction for DeepSeek Harness: after each turn, suggest the user's next message in a bar above the composer. Tab accepts into the draft without sending.",
  "license": "MIT",
  "author": "HZZ2Z",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HZZ2Z/dsh_nextStep.git"
  },
  "homepage": "https://github.com/HZZ2Z/dsh_nextStep#readme",
  "bugs": {
    "url": "https://github.com/HZZ2Z/dsh_nextStep/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "next-step",
    "prediction",
    "composer"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
